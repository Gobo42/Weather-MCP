     "type": "string"
    },
    {
     "name": "request_id",
     "type": "string"
    },
    {
     "name": "start_date",
     "type": "date"
    },
    {
     "name": "end_date",
     "type": "date"
    },
    {
     "name": "state",
     "type": "string"
    },
    {
     "name": "created_at",
     "type": "timestamp"
    },
    {
     "name": "started_at",
     "type": "timestamp",
     "nullable": true
    },
    {
